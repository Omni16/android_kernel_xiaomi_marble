# DroidSpaces GKI-SAFE fragment for Melt marble (5.10)
# Follows ravindu644/Droidspaces-OSS GKI-Exclusive configuration:
# only options proven kABI-safe with the SYSVIPC/POSIX_MQUEUE kABI patches
# (both already present in melt-rebase). Safe to use with stock vendor_dlkm.
# Merged AFTER marble_defconfig via scripts/kconfig/merge_config.sh.

# IPC
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y

# Namespaces
CONFIG_IPC_NS=y
CONFIG_PID_NS=y

# HW access
CONFIG_DEVTMPFS=y

# Networking (enhanced NAT support)
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y

# Fix for docker unsafe procfs error
CONFIG_USER_NS=y

# UFW support
CONFIG_NETFILTER_XT_TARGET_REJECT=y
CONFIG_NETFILTER_XT_TARGET_LOG=y
CONFIG_NETFILTER_XT_MATCH_RECENT=y

# Fail2ban support
CONFIG_IP_SET=y
CONFIG_IP_SET_HASH_IP=y
CONFIG_IP_SET_HASH_NET=y
CONFIG_NETFILTER_XT_SET=y

# xattr / posix acl on tmpfs (NixOS support)
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y

# Firmware loading
CONFIG_FW_LOADER_COMPRESS=y
